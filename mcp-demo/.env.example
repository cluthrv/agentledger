# Anthropic (you already set this permanently; can also live here)
ANTHROPIC_API_KEY=sk-ant-...

# Arbitrum Sepolia anchoring
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ANCHOR_PRIVATE_KEY=0xyour_funded_testnet_wallet_private_key
# Set this after running: npm run deploy
ANCHOR_CONTRACT_ADDRESS=

# Verification: the anchorer address(es) a verifier trusts, comma-separated.
# Defaults to the wallet behind ANCHOR_PRIVATE_KEY. An auditor sets this (plus
# the RPC URL and contract address) and needs no private key.
# ANCHOR_TRUSTED_ADDRESSES=0x...

# Signing keys. By default they are generated on first run into data/keys/
# (gateway.key.pem, bureau.key.pem, and matching .pub.pem files that the
# verifier pins). Override with PEM values here if you manage keys elsewhere.
# GATEWAY_SIGNING_KEY=
# GATEWAY_PUBLIC_KEY=
# BUREAU_SIGNING_KEY=
# BUREAU_PUBLIC_KEY=

# Sign a checkpoint of the running Merkle root every N records (0 = only at seal).
# CHECKPOINT_EVERY=5
